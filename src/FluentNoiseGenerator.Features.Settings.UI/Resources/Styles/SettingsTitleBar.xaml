<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:FluentNoiseGenerator.Features.Settings.UI.Controls">
    <Style TargetType="controls:SettingsTitleBar">
        <Setter Property="Height" Value="{ThemeResource SettingsTitleBarHeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsTitleBar">
                    <Grid Height="{TemplateBinding Height}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Width="{ThemeResource SettingsTitleBarIconSize}"
                               Height="{ThemeResource SettingsTitleBarIconSize}"
                               Margin="{ThemeResource SettingsTitleBarIconMargin}"
                               VerticalAlignment="Center"
                               Source="{ThemeResource SettingsTitleBarIconSource}"/>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="{ThemeResource SettingsTitleBarFontSize}"
                                   Text="{TemplateBinding Title}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
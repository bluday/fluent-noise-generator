<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="FluentNoiseGenerator.Features.Playback.UI.Windows.PlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:playbackControls="using:FluentNoiseGenerator.Features.Playback.UI.Controls"
        Title="{x:Bind ViewModel.Title}"
        x:DefaultBindMode="OneWay"
        mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <playbackControls:PlaybackTopBar x:Name="TopBar"
                                         Grid.Row="0"
                                         CloseButtonClickCommand="{x:Bind ViewModel.CloseWindowCommand}"
                                         SettingsButtonClickCommand="{x:Bind ViewModel.OpenSettingsCommand}"/>

        <playbackControls:PlaybackControlPanel Grid.Row="1"
                                               IsPlaying="{x:Bind ViewModel.IsPlaying}"
                                               PlaybackButtonClickCommand="{x:Bind ViewModel.TogglePlaybackCommand}"
                                               Volume="{x:Bind ViewModel.CurrentVolume}"/>
    </Grid>
</Window>
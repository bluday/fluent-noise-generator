<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CornerRadius x:Key="PlaybackControlPanelPlaybackButtonCornerRadius">40</CornerRadius>
    <CornerRadius x:Key="PlaybackControlPanelPresetCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PlaybackTopBarDragHandleCornerRadius">2</CornerRadius>

    <SolidColorBrush x:Key="PlaybackControlPanelButtonBackgroundBrush"
                     Color="Transparent"/>
    <SolidColorBrush x:Key="PlaybackControlPanelButtonBorderBrush"
                     Color="Transparent"/>
    <SolidColorBrush x:Key="PlaybackTopBarDragHandleBackgroundBrush"
                     Color="{ThemeResource ControlStrongFillColorDefault}"/>

    <StaticResource x:Key="PlaybackTopBarBorderBrush"
                    ResourceKey="ControlElevationBorderBrush"/>

    <Thickness x:Key="PlaybackControlPanelButtonBorderThickness">0</Thickness>
    <Thickness x:Key="PlaybackControlPanelButtonPadding">8</Thickness>
    <Thickness x:Key="PlaybackControlPanelPresetItemMargin">4,8</Thickness>
    <Thickness x:Key="PlaybackControlPanelPresetsHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="PlaybackTopBarBorderThickness">0,0,0,1</Thickness>
    <Thickness x:Key="PlaybackTopBarButtonPadding">0</Thickness>
    <Thickness x:Key="PlaybackTopBarDragHandleBorderThickness">0</Thickness>
    <Thickness x:Key="PlaybackTopBarPadding">4</Thickness>

    <x:Double x:Key="PlaybackControlPanelButtonSize">32</x:Double>
    <x:Double x:Key="PlaybackControlPanelHeaderFontSize">16</x:Double>
    <x:Double x:Key="PlaybackControlPanelPlaybackButtonSize">48</x:Double>
    <x:Double x:Key="PlaybackControlPanelPresetColorSize">24</x:Double>
    <x:Double x:Key="PlaybackControlPanelPresetItemSpacing">12</x:Double>
    <x:Double x:Key="PlaybackControlPanelPresetsFlyoutWidth">200</x:Double>
    <x:Double x:Key="PlaybackControlPanelSpacing">8</x:Double>
    <x:Double x:Key="PlaybackControlPanelVolumeFlyoutSpacing">10</x:Double>
    <x:Double x:Key="PlaybackControlPanelVolumeSliderWidth">150</x:Double>
    <x:Double x:Key="PlaybackControlPanelVolumeValueWidth">32</x:Double>
    <x:Double x:Key="PlaybackTopBarButtonSize">22</x:Double>
    <x:Double x:Key="PlaybackTopBarCloseButtonFontSize">10</x:Double>
    <x:Double x:Key="PlaybackTopBarDragHandleHeight">3</x:Double>
    <x:Double x:Key="PlaybackTopBarDragHandleWidth">32</x:Double>
    <x:Double x:Key="PlaybackTopBarSettingsButtonFontSize">14</x:Double>

    <x:Boolean x:Key="PlaybackControlPanelFlyoutAnimationsEnabled">True</x:Boolean>
    <x:Boolean x:Key="PlaybackControlPanelFlyoutConstrainToRootBounds">False</x:Boolean>

    <x:String x:Key="PlaybackControlPanelPauseGlyph">&#xf8ae;</x:String>
    <x:String x:Key="PlaybackControlPanelPlayGlyph">&#xf5b0;</x:String>
    <x:String x:Key="PlaybackControlPanelPresetsGlyph">&#xf61f;</x:String>
    <x:String x:Key="PlaybackControlPanelVolumeGlyph">&#xe767;</x:String>
    <x:String x:Key="PlaybackTopBarCloseButtonGlyph">&#xe8bb;</x:String>
    <x:String x:Key="PlaybackTopBarSettingsButtonGlyph">&#xe713;</x:String>
</ResourceDictionary>
<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:FluentNoiseGenerator.Features.Playback.UI.Controls">
    <Style x:Key="PlaybackTopBarButtonStyle"
           BasedOn="{StaticResource DefaultButtonStyle}"
           TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="{ThemeResource PlaybackTopBarButtonSize}"/>
        <Setter Property="Padding" Value="{ThemeResource PlaybackTopBarButtonPadding}"/>
        <Setter Property="Width" Value="{ThemeResource PlaybackTopBarButtonSize}"/>
    </Style>

    <Style TargetType="controls:PlaybackTopBar">
        <Setter Property="Padding" Value="{ThemeResource PlaybackTopBarPadding}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource PlaybackTopBarBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{ThemeResource PlaybackTopBarBorderThickness}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PlaybackTopBar">
                    <Grid Padding="{TemplateBinding Padding}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PART_SettingsButton"
                                Grid.Column="0"
                                Command="{TemplateBinding SettingsButtonClickCommand}"
                                Style="{ThemeResource PlaybackTopBarButtonStyle}">
                            <FontIcon FontSize="{ThemeResource PlaybackTopBarSettingsButtonFontSize}"
                                      Glyph="{ThemeResource PlaybackTopBarSettingsButtonGlyph}"/>
                        </Button>

                        <Border Grid.ColumnSpan="3"
                                Width="{ThemeResource PlaybackTopBarDragHandleWidth}"
                                Height="{ThemeResource PlaybackTopBarDragHandleHeight}"
                                VerticalAlignment="Center"
                                Background="{ThemeResource PlaybackTopBarDragHandleBackgroundBrush}"
                                BorderThickness="{ThemeResource PlaybackTopBarDragHandleBorderThickness}"
                                CornerRadius="{ThemeResource PlaybackTopBarDragHandleCornerRadius}"/>

                        <Button x:Name="PART_CloseButton"
                                Grid.Column="2"
                                Command="{TemplateBinding CloseButtonClickCommand}"
                                Style="{ThemeResource PlaybackTopBarButtonStyle}">
                            <FontIcon FontSize="{ThemeResource PlaybackTopBarCloseButtonFontSize}"
                                      Glyph="{ThemeResource PlaybackTopBarCloseButtonGlyph}"/>
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>